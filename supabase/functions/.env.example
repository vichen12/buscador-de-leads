# Secretos de las Edge Functions. Cargalos con:
#   supabase secrets set --env-file supabase/functions/.env
ANTHROPIC_API_KEY=sk-ant-...        # opcional: sin esto, los borradores salen de plantillas
MODELO_IA=claude-sonnet-5-5          # opcional
GOOGLE_PLACES_API_KEY=AIza...        # opcional: sólo para "Buscar en Google"
